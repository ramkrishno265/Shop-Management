generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

model Shop {
  id        Int      @id @default(autoincrement())
  name      String
  logo      String?
  phone     String?
  email     String?
  address   String?
  status    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  products         Product[]
  sales            Sale[]
  customers        Customer[]
  categories       Category[]
  suppliers        Supplier[]
  purchases        Purchase[]
  expenses         Expense[]
  customerPayments CustomerPayment[]

  @@map("shops")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String
  password  String
  photo     String?

  role      Role     @default(CASHIER)
  status    Boolean  @default(true)

  shopId    Int
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  sales            Sale[]
  purchases        Purchase[]
  stockLogs        StockLog[]
  expenses         Expense[]
  customerPayments CustomerPayment[]

  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  shopId    Int
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  sales            Sale[]
  customerPayments CustomerPayment[]

  @@map("customers")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  note      String?
  createdAt DateTime @default(now())

  shopId    Int
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  purchases Purchase[]

  @@map("suppliers")
}

model Category {
  id       Int      @id @default(autoincrement())
  name     String
  shopId   Int
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  products Product[]

  @@unique([name, shopId]) 
  @@map("categories")
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  sku           String?  @unique
  barcode       String?  @unique 
  quantity      Float    @default(0)
  unit          String
  lowStockLimit Float    @default(5)
  purchasePrice Float
  sellingPrice  Float
  description   String?
  status        String   @default("ACTIVE")

  categoryId    Int?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  shopId        Int
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  stockLogs     StockLog[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("products")
}

model StockLog {
  id              Int      @id @default(autoincrement())
  productId       Int
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId          Int?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  changeType      String   // PURCHASE, SALE, RETURN, DAMAGE, ADJUST
  quantityChanged Float
  previousStock   Float
  newStock        Float
  note            String?

  createdAt       DateTime @default(now())

  @@map("stock_logs")
}

model Purchase {
  id             Int          @id @default(autoincrement())
  invoiceNo      String       @unique

  shopId         Int
  shop           Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  supplier_id    Int
  supplier       Supplier     @relation(fields: [supplier_id], references: [id], onDelete: Cascade)

  date           String
  payment_status String       @default("Paid")
  product        String
  quantity       Float
  unit_price     Float
  total_amount   Float
  paid_amount    Float        @default(0)
  due_amount     Float        @default(0)
  note           String?

  createdBy      Int?
  user           User?        @relation(fields: [createdBy], references: [id])

  purchaseItems  PurchaseItem[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("purchases")
}

model PurchaseItem {
  id            Int      @id @default(autoincrement())
  purchaseId    Int
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId     Int?
  product       Product? @relation(fields: [productId], references: [id])

  productName   String?
  quantity      Float
  unitPrice     Float
  totalPrice    Float

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("purchase_items")
}

model SaleItem {
  id            Int      @id @default(autoincrement())
  saleId        Int
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId     Int
  product       Product  @relation(fields: [productId], references: [id])

  quantity      Float
  unitPrice     Float
  purchasePrice Float
  discount      Float    @default(0)
  subtotal      Float

  createdAt     DateTime @default(now())

  @@map("sale_items")
}

model Sale {
  id             Int      @id @default(autoincrement())
  invoiceNo      String   @unique

  shopId         Int
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  customerId     Int?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdBy      Int
  user           User     @relation(fields: [createdBy], references: [id])

  subtotal       Float
  discountType   String?  // FIXED or PERCENTAGE
  discountValue  Float    @default(0)
  discountAmount Float    @default(0)
  vatPercentage  Float    @default(0)
  vatAmount      Float    @default(0)
  grandTotal     Float
  paidAmount     Float
  dueAmount      Float    @default(0)
  changeAmount   Float    @default(0)
  paymentMethod  String   // CASH, BKASH, CARD
  paymentStatus  String   @default("PAID") // PAID, DUE, PARTIAL

  notes          String?

  saleItems      SaleItem[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("sales")
}

model CustomerPayment {
  id            Int      @id @default(autoincrement())
  shopId        Int
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  customerId    Int
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  userId        Int
  user          User     @relation(fields: [userId], references: [id])

  amount        Float    
  paymentMethod String   
  notes         String?

  createdAt     DateTime @default(now())

  @@map("customer_payments")
}

model Expense {
  id       Int      @id @default(autoincrement())
  shopId   Int
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  title    String   // যেমন: দোকান ভাড়া, বিদ্যুৎ বিল ইত্যাদি
  amount   Float
  category String   // Rent, Utilities, Salary ইত্যাদি
  note     String?

  userId   Int
  user     User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("expenses")
}